reticulate::repl_python()
library(lubridate)
library(dplyr)
library(here)
library(keras)
library(tensorflow)
library(caret)
case_study <- "feeagh"
dir <- paste0(here(), "/", case_study, "/")
# Load data
data <- read.csv(paste0(dir, "data/data.csv"))
data$date <- as.Date(data$date)
data$cyday <- cos(yday(data$date) * pi / 180)
if (case_study=="feeagh"){
data <- data[, c("swt", "sr", "st100", "st255", "sm100", "sm255",
"doc_gwlf", "cyday", "fdom", "date")]
}
if (case_study=="sau"){
data <- data[, c("v", "st255", "sm100", "sm255", "cyday", "fdom", "date")]
}
# Train/test split (last 15%)
n <- nrow(data)
n_holdout <- round(n * 0.15)
train_data <- data[1:(n - n_holdout), ]
test_data <- data[(n - n_holdout + 1):n, ]
X_train <- train_data %>% select(-fdom, -date)
y_train <- train_data$fdom
X_test <- test_data %>% select(-fdom, -date)
y_test <- test_data$fdom
r2 <- function(obs, pred) cor(obs, pred)^2
rmse <- function(obs, pred) sqrt(mean((obs - pred)^2))
nse <- function(obs, pred) {
1 - sum((obs - pred)^2) / sum((obs - mean(obs))^2)
}
kge <- function(obs, pred) {
r <- cor(pred, obs)
alpha <- sd(pred) / sd(obs)
beta <- mean(pred) / mean(obs)
1 - sqrt((r - 1)^2 + (alpha - 1)^2 + (beta - 1)^2)
}
scale_params <- preProcess(X_train, method = c("center", "scale"))
X_train_nn <- predict(scale_params, X_train)
X_test_nn  <- predict(scale_params, X_test)
y_mean <- mean(y_train)
y_sd   <- sd(y_train)
y_train_nn <- (y_train - y_mean) / y_sd
y_test_nn  <- (y_test - y_mean) / y_sd
set.seed(123)
n_features <- ncol(X_train_nn)
mlp_model <- keras_model_sequential() %>%
layer_dense(units = 64, activation = "relu", input_shape = n_features) %>%
layer_dropout(rate = 0.2) %>%
layer_dense(units = 32, activation = "relu") %>%
layer_dropout(rate = 0.2) %>%
layer_dense(units = 1)
reticulate::repl_python()
